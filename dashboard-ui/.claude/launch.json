{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "api-server",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "--prefix",
                "../server",
                "run",
                "dev"
            ],
            "port": 8081
        },
        {
            "name": "dashboard-ui",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev",
                "--",
                "--port",
                "5174",
                "--strictPort"
            ],
            "port": 5174
        },
        {
            "name": "storybook",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "storybook",
                "--",
                "--no-open"
            ],
            "port": 6006
        }
    ]
}
